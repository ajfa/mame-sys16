+++ b/src/devices/cpu/ns32000/ns32000.cpp
@@ -4001,7 +4001,10 @@ template <int HighBits, int Width> void ns32000_device<HighBits, Width>::execute
 				if (machine().debug_enabled())
 					machine().debug_break();
 				else
-					fatalerror("abort during abort entry 0x%08x\n", m_pc);
+				{
+					logerror("abort during abort entry 0x%08x\n", m_pc);
+					suspend(SUSPEND_REASON_HALT, true);
+				}
